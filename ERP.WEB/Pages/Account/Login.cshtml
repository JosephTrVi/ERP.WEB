@page
@model ERP.WEB.Pages.Account.LoginModel

@{
    Layout = null; // No utiliza el layout principal con la barra lateral
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - ERP PLANTA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="card border-0 shadow-sm login-card bg-white p-4">
        <div class="text-center mb-4">
            <div class="mb-2">
                <i class="bi bi-gear-wide-connected text-primary display-4"></i>
            </div>
            <h4 class="fw-bold text-dark mb-0">ERP PLANTA</h4>
            <small class="text-muted">Gestión de Manufactura e Inventarios</small>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.UserName" class="form-label small fw-bold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="Input.UserName" class="form-control border-start-0" placeholder="Ingrese su usuario" autofocus />
                </div>
                <span asp-validation-for="Input.UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label small fw-bold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Input.Password" class="form-control border-start-0" placeholder="******" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" id="chkRemember">
                <label class="form-check-label small text-secondary" for="chkRemember">
                    Recordar en este dispositivo
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </button>
        </form>
    </div>
</body>
</html>