@page "{id:int}"
@model ERP.WEB.Pages.Ventas.DetalleCotizacionModel
@{
    ViewData["Title"] = "Detalle de Cotización";
    string simbolo = Model.Cotizacion.Moneda == "USD" ? "$" : "S/";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Cotización: @Model.Cotizacion.Codigo</h4>
        <small class="text-muted">Revisión preliminar previa a aprobación comercial</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Ventas/AprobacionCotizaciones" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Regresar a la Bandeja
        </a>

        @if (Model.Cotizacion.Estado != "Aprobada" && Model.Cotizacion.Estado != "Rechazada")
        {
            <form method="post" asp-page-handler="Rechazar" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cotizacionId" value="@Model.Cotizacion.CotizacionID" />
                <button type="submit" class="btn btn-danger btn-sm fw-semibold" onclick="return confirm('¿Está seguro de rechazar la cotización @Model.Cotizacion.Codigo?');">
                    <i class="bi bi-x-circle me-1"></i> Rechazar
                </button>
            </form>

            <form method="post" asp-page-handler="Aprobar" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cotizacionId" value="@Model.Cotizacion.CotizacionID" />
                <button type="submit" class="btn btn-success btn-sm fw-semibold" onclick="return confirm('¿Desea aprobar comercialmente la cotización @Model.Cotizacion.Codigo?');">
                    <i class="bi bi-check-circle me-1"></i> Aprobar Cotización
                </button>
            </form>
        }
        else
        {
            <span class="badge fs-6 @(Model.Cotizacion.Estado == "Aprobada" ? "bg-success" : "bg-danger") d-flex align-items-center">
                <i class="bi bi-info-circle me-1"></i> Estado: @Model.Cotizacion.Estado
            </span>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- INFORMACIÓN DE CABECERA Y CLIENTE -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light py-2">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Información del Cliente</h6>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-md-7">
                        <small class="text-muted d-block">Cliente / Razón Social</small>
                        <strong class="text-dark fs-6">@Model.Cotizacion.ClienteNombre</strong>
                    </div>
                    <div class="col-md-5">
                        <small class="text-muted d-block">Dirección de Entrega</small>
                        <span class="text-dark fw-semibold">@(string.IsNullOrEmpty(Model.Cotizacion.ClienteDireccion) ? "No especificada" : Model.Cotizacion.ClienteDireccion)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light py-2">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-card-heading me-2 text-primary"></i>Datos de Emisión</h6>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Fecha Emisión:</span>
                    <strong class="text-dark">@Model.Cotizacion.FechaEmision.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Moneda:</span>
                    <span class="badge bg-light text-dark border">@Model.Cotizacion.Moneda</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Estado Actual:</span>
                    <strong class="@(Model.Cotizacion.Estado == "Aprobada" ? "text-success" : Model.Cotizacion.Estado == "Rechazada" ? "text-danger" : "text-warning")">
                        @Model.Cotizacion.Estado
                    </strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TABLA DE DETALLE DE PRODUCTOS / ÍTEMS COTIZADOS CON VERIFICACIÓN DE STOCK -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Productos / Ítems Cotizados</h6>
        <span class="badge bg-light text-dark fs-7"><i class="bi bi-shop me-1 text-primary"></i>Verificación de Inventario</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Descripción del Ítem</th>
                        <th class="text-center" style="width: 90px;">U.M.</th>
                        <th class="text-end" style="width: 120px;">Cant. Requerida</th>
                        <th class="text-center" style="width: 150px;">Disponibilidad / Stock</th>
                        <th class="text-end" style="width: 150px;">Precio Unit. (Sin IGV)</th>
                        <th class="text-end" style="width: 160px;">SubTotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cotizacion.Detalles != null && Model.Cotizacion.Detalles.Any())
                    {
                        int index = 1;
                        foreach (var item in Model.Cotizacion.Detalles)
                        {
                            // Nota: Si consultas el stock desde el modelo de Artículos/Productos:
                            // decimal stockDisponible = item.Producto?.StockActual ?? 0;
                            // Por ahora simularemos la lógica de validación visual:
                            bool hayStock = true; // Cambiar por: (stockDisponible >= item.Cantidad)

                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.DescripcionItem</div>
                                    @if (item.ProductoID.HasValue)
                                    {
                                        <small class="text-muted">Código Prod: #@item.ProductoID</small>
                                    }
                                </td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@item.UnidadMedida</span></td>
                                <td class="text-end fw-bold text-dark">@item.Cantidad.ToString("N2")</td>

                                <!-- COLUMNA DE ESTADO DE STOCK -->
                                <td class="text-center">
                                    @if (hayStock)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Con Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Sin Stock
                                        </span>
                                    }
                                </td>

                                <td class="text-end fw-semibold">@simbolo @item.PrecioUnitarioSinIGV.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">@simbolo @item.SubTotalItem.ToString("N2")</td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No hay ítems registrados en esta cotización.</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="6" class="text-end fw-semibold text-muted">SubTotal (Sin IGV):</td>
                        <td class="text-end fw-bold text-dark">@simbolo @Model.Cotizacion.SubTotal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-end fw-semibold text-muted">IGV (18%):</td>
                        <td class="text-end fw-semibold text-dark">@simbolo @Model.Cotizacion.IGV.ToString("N2")</td>
                    </tr>
                    <tr class="table-active">
                        <td colspan="6" class="text-end fw-bold fs-6 text-dark">Total General:</td>
                        <td class="text-end fw-bold fs-5 text-success">@simbolo @Model.Cotizacion.Total.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>