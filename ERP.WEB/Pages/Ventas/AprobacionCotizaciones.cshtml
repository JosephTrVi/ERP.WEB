@page
@model ERP.WEB.Pages.Ventas.AprobacionCotizacionesModel
@{
    ViewData["Title"] = "Aprobación de Cotizaciones - Gerencia";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-shield-check me-2 text-primary"></i>Aprobación de Cotizaciones</h4>
        <small class="text-muted">Bandeja de Gerencia de Ventas para autorizar propuestas comerciales</small>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Fecha Emisión</th>
                        <th>Fecha Entrega</th>
                        <th class="text-end">Total Propuesta</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acción Gerencial</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Pendientes.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-check-circle fs-2 d-block text-success mb-2"></i> No hay cotizaciones pendientes de aprobación gerencial.</td></tr>
                    }
                    else
                    {
                        @foreach (var c in Model.Pendientes)
                        {
                            string sim = c.Moneda == "USD" ? "$" : "S/";
                            <tr>
                                <td class="fw-bold text-primary">@c.Codigo</td>
                                <td class="fw-bold text-dark">@c.ClienteNombre</td>
                                <td><small class="text-muted">@c.FechaEmision.ToString("dd/MM/yyyy")</small></td>
                                <td><small class="fw-semibold text-dark">@c.FechaEntregaAprox.ToString("dd/MM/yyyy")</small></td>
                                <td class="text-end fw-bold text-success">@sim @c.Total.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-warning text-dark">Pendiente</span></td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Procesar" class="d-inline">
                                        <input type="hidden" name="cotizacionId" value="@c.CotizacionID" />
                                        <button type="submit" name="accion" value="Aprobar" class="btn btn-sm btn-success fw-semibold me-1"><i class="bi bi-check-lg"></i> Aprobar</button>
                                        <button type="submit" name="accion" value="Rechazar" class="btn btn-sm btn-outline-danger fw-semibold"><i class="bi bi-x-lg"></i> Rechazar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>