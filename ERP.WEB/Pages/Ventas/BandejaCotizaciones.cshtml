@page
@model ERP.WEB.Pages.Ventas.BandejaCotizacionesModel
@{
    ViewData["Title"] = "Bandeja de Cotizaciones de Venta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-file-earmark-text me-2 text-primary"></i>Cotizaciones de Venta
        </h4>
        <small class="text-muted">Gestión comercial y seguimiento de propuestas a clientes</small>
    </div>
    <a asp-page="/Ventas/NuevaCotizacion" class="btn btn-primary btn-sm fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nueva Cotización
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- BARRA DE FILTROS -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded-3 p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-calendar-event me-1"></i>Año</label>
                <select asp-for="Anio" asp-items="Model.SelectAnios" class="form-select form-select-sm" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-calendar-month me-1"></i>Mes</label>
                <select asp-for="Mes" asp-items="Model.SelectMeses" class="form-select form-select-sm" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Estado</label>
                <select class="form-select form-select-sm" asp-for="EstadoFiltro" onchange="this.form.submit()">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Registrada">Registrada</option>
                    <option value="Aprobada">Aprobada</option>
                    <option value="Rechazada">Rechazada</option>
                    <option value="Facturada">Facturada</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Buscar Código / Cliente</label>
                <input type="text" class="form-control form-control-sm" asp-for="Busqueda" placeholder="Ej: COT-2026-0001..." />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-page="/Ventas/BandejaCotizaciones" class="btn btn-outline-secondary btn-sm" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE COTIZACIONES -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Cliente / Razón Social</th>
                        <th>Fecha Emisión</th>
                        <th>Moneda</th>
                        <th class="text-end">Total Sin IGV</th>
                        <th class="text-end">Total General</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaCotizaciones.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No se encontraron cotizaciones registradas para el periodo seleccionado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cot in Model.ListaCotizaciones)
                        {
                            string simbolo = cot.Moneda == "USD" ? "$" : "S/";
                            <tr>
                                <td class="fw-bold text-primary">@cot.Codigo</td>
                                <td>
                                    <div class="fw-bold text-dark">@cot.ClienteNombre</div>
                                    <small class="text-muted">@cot.ClienteDireccion</small>
                                </td>
                                <td><small class="text-dark fw-semibold">@cot.FechaEmision.ToString("dd/MM/yyyy")</small></td>
                                <td><span class="badge bg-light text-dark border">@cot.Moneda</span></td>
                                <td class="text-end fw-semibold">@simbolo @cot.SubTotal.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">@simbolo @cot.Total.ToString("N2")</td>
                                <td class="text-center">
                                    @if (cot.Estado == "Registrada")
                                    {
                                        <span class="badge bg-primary">Registrada</span>
                                    }
                                    else if (cot.Estado == "Aprobada")
                                    {
                                        <span class="badge bg-success">Aprobada</span>
                                    }
                                    else if (cot.Estado == "Rechazada")
                                    {
                                        <span class="badge bg-danger">Rechazada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@cot.Estado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-page="/Ventas/DetalleCotizacion" asp-route-id="@cot.CotizacionID" class="btn btn-sm btn-outline-info p-1" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>