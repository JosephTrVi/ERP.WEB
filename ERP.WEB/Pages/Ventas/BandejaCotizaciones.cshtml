@page
@model ERP.WEB.Pages.Ventas.BandejaCotizacionesModel
@{
    ViewData["Title"] = "Bandeja de Cotizaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Cotizaciones de Venta</h4>
        <small class="text-muted">Registro y seguimiento de propuestas comerciales</small>
    </div>
    <a asp-page="/Ventas/NuevaCotizacion" class="btn btn-success fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nueva Cotización
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FILTROS DE BÚSQUEDA -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded-3 p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Estado de la Cotización</label>
                <select class="form-select form-select-sm" asp-for="EstadoFiltro">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Pendiente">Pendiente de Aprobación</option>
                    <option value="Aprobado">Aprobado por Gerencia</option>
                    <option value="Rechazado">Rechazado</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-muted mb-1">Buscar por Código / Cliente</label>
                <input type="text" class="form-control form-control-sm" asp-for="Busqueda" placeholder="Ej: COT-2026-0001 o Nombre de Cliente..." />
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100"><i class="bi bi-funnel me-1"></i> Filtrar</button>
                <a asp-page="/Ventas/BandejaCotizaciones" class="btn btn-outline-secondary btn-sm" title="Limpiar Filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE COTIZACIONES -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Cliente / Empresa</th>
                        <th>Fecha Emisión</th>
                        <th>Fecha Entrega Aprox.</th>
                        <th class="text-end">Total Propuesta</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaCotizaciones.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i> No se encontraron cotizaciones registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.ListaCotizaciones)
                        {
                            string sim = c.Moneda == "USD" ? "$" : "S/";
                            <tr>
                                <td class="fw-bold text-primary">@c.Codigo</td>
                                <td>
                                    <strong class="text-dark">@c.ClienteNombre</strong>
                                    <br /><small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@c.ClienteDireccion</small>
                                </td>
                                <td><small class="text-muted">@c.FechaEmision.ToString("dd/MM/yyyy")</small></td>
                                <td><small class="fw-semibold text-dark">@c.FechaEntregaAprox.ToString("dd/MM/yyyy")</small></td>
                                <td class="text-end fw-bold text-success">@sim @c.Total.ToString("N2")</td>
                                <td class="text-center">
                                    @if (c.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    else if (c.Estado == "Aprobado")
                                    {
                                        <span class="badge bg-success">Aprobado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rechazado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" onclick='verDetallesCotizacion(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles })))'>
                                        <i class="bi bi-eye me-1"></i> Ver Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL VER DETALLE COTIZACIÓN -->
<div class="modal fade" id="modalDetalleCotiz" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="modalTituloCotiz"><i class="bi bi-file-earmark-text me-2"></i> Detalle de Cotización</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3 bg-light p-3 rounded border">
                    <div class="col-md-6"><small class="text-muted d-block">Cliente:</small> <strong id="lblCliente"></strong></div>
                    <div class="col-md-6"><small class="text-muted d-block">Dirección de Entrega:</small> <span id="lblDireccion" class="fw-semibold text-dark"></span></div>
                    <div class="col-md-4 mt-2"><small class="text-muted d-block">Forma de Pago:</small> <strong id="lblFormaPago"></strong></div>
                    <div class="col-md-4 mt-2"><small class="text-muted d-block">Moneda / TC:</small> <strong id="lblMonedaTC"></strong></div>
                    <div class="col-md-4 mt-2"><small class="text-muted d-block">Estado Aprobación:</small> <span id="lblEstadoBadge"></span></div>
                </div>

                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-list-check me-1 text-primary"></i> Ítems Cotizados</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Descripción</th>
                                <th>U.M.</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Precio Unit. (Sin IGV)</th>
                                <th class="text-end">SubTotal</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDetallesModal"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetallesCotizacion(c) {
            document.getElementById('modalTituloCotiz').innerText = `Cotización ${c.Codigo || c.codigo}`;
            document.getElementById('lblCliente').innerText = c.ClienteNombre || c.clienteNombre;
            document.getElementById('lblDireccion').innerText = c.ClienteDireccion || c.clienteDireccion;
            document.getElementById('lblFormaPago').innerText = c.FormaPago || c.formaPago;

            const mon = c.Moneda || c.moneda;
            const tc = c.TipoCambio || c.tipoCambio;
            document.getElementById('lblMonedaTC').innerText = `${mon} (TC: ${tc})`;

            const est = c.Estado || c.estado;
            const badge = document.getElementById('lblEstadoBadge');
            if (est === 'Aprobado') {
                badge.className = 'badge bg-success';
                badge.innerText = 'Aprobado por Gerencia';
            } else if (est === 'Pendiente') {
                badge.className = 'badge bg-warning text-dark';
                badge.innerText = 'Pendiente de Aprobación';
            } else {
                badge.className = 'badge bg-danger';
                badge.innerText = 'Rechazado';
            }

            const tbody = document.getElementById('tbodyDetallesModal');
            tbody.innerHTML = '';

            const detalles = c.Detalles || c.detalles || [];
            detalles.forEach(d => {
                const desc = d.DescripcionItem || d.descripcionItem;
                const um = d.UnidadMedida || d.unidadMedida;
                const cant = d.Cantidad !== undefined ? d.Cantidad : d.cantidad;
                const precio = d.PrecioUnitarioSinIGV !== undefined ? d.PrecioUnitarioSinIGV : d.precioUnitarioSinIGV;
                const subTotal = d.SubTotalItem !== undefined ? d.SubTotalItem : d.subTotalItem;

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${desc}</strong></td>
                        <td><span class="badge bg-secondary">${um}</span></td>
                        <td class="text-end fw-bold">${cant}</td>
                        <td class="text-end">${precio.toFixed(2)}</td>
                        <td class="text-end text-primary fw-bold">${subTotal.toFixed(2)}</td>
                    </tr>`;
            });

            const modal = new bootstrap.Modal(document.getElementById('modalDetalleCotiz'));
            modal.show();
        }
    </script>
}