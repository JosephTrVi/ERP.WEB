@page
@model ERP.WEB.Pages.Produccion.Recetas.IndexModel
@{
    ViewData["Title"] = "Catálogo de Recetas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Catálogo de Recetas</h4>
        <small class="text-muted">Consulta de fórmulas de producción y componentes por SKU</small>
    </div>
    <a asp-page="/Produccion/Recetas/Crear" class="btn btn-primary btn-sm fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Nueva Receta
    </a>
</div>

<!-- BARRA DE FILTROS -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Buscar por Código / SKU / Nombre</label>
                <input type="text" class="form-control form-control-sm" asp-for="Buscar" placeholder="Ej: COT-05, Hamburguesa..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Categoría</label>
                <select class="form-select form-select-sm" asp-for="CategoriaID" asp-items="Model.SelectCategorias" onchange="cargarSubcategorias(this.value)">
                    <option value="">-- Todas las Categorías --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">SubCategoría</label>
                <select class="form-select form-select-sm" asp-for="SubcategoriaID" asp-items="Model.SelectSubcategorias" id="ddlSubcategoria">
                    <option value="">-- Todas las SubCategorías --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-page="/Produccion/Recetas/Index" class="btn btn-outline-secondary btn-sm" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE RECETAS -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white py-2">
        <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Recetas de Producción</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>SKU PT</th>
                        <th>Producto a Fabricar</th>
                        <th>Categoría / SubCat</th>
                        <th>Nombre Receta</th>
                        <th class="text-center">Ítems</th>
                        <th class="text-end">Costo Est. Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaRecetas.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-search fs-3 d-block mb-2"></i>
                                Seleccione un filtro o presione <strong>Filtrar</strong> para buscar recetas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.ListaRecetas)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.SKUPT</td>
                                <td class="fw-bold text-dark">@item.NombrePT</td>
                                <td><small class="text-muted">@item.CategoriaPT / @item.SubCategoriaPT</small></td>
                                <td><span class="badge bg-light text-dark border">@item.NombreReceta</span></td>
                                <td class="text-center"><span class="badge bg-secondary">@item.TotalInsumos</span></td>
                                <td class="text-end fw-bold text-success">S/ @item.CostoEstimadoTotal.ToString("N2")</td>
                                <td class="text-center">
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactiva</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-info" onclick="verDetalleReceta(@item.RecetaID)" title="Ver Detalle / Componentes">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL PARA MOSTRAR COMPONENTES / INSUMOS DESGLOSADOS POR SKU -->
<div class="modal fade" id="modalDetalleReceta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title fw-bold" id="lblModalTitulo"><i class="bi bi-journal-text me-2"></i>Detalle de Receta</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="loadingModal" class="text-center py-4">
                    <span class="spinner-border spinner-border-sm me-1"></span> Cargando componentes de la fórmula...
                </div>

                <div id="contenidoModal" class="d-none">
                    <div class="bg-light p-2 rounded mb-3 border">
                        <div class="row">
                            <div class="col-md-4"><strong>SKU Producto:</strong> <span id="modalSkuPT" class="text-primary fw-bold"></span></div>
                            <div class="col-md-8"><strong>Producto:</strong> <span id="modalNombrePT" class="fw-bold"></span></div>
                        </div>
                    </div>

                    <div class="table-responsive border rounded">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>SKU Insumo</th>
                                    <th>Insumo / Componente</th>
                                    <th>Categoría / SubCat</th>
                                    <th class="text-end">Cant. Requerida</th>
                                    <th class="text-center">U.M.</th>
                                    <th class="text-end">Costo Unit.</th>
                                    <th class="text-end">SubTotal</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDetalleInsumos"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function cargarSubcategorias(categoriaId) {
            const ddlSubcat = document.getElementById('ddlSubcategoria');
            ddlSubcat.innerHTML = '<option value="">-- Todas las SubCategorías --</option>';

            if (!categoriaId) return;

            try {
                const res = await fetch(`?handler=SubcategoriasPorCategoria&categoriaId=${categoriaId}`);
                if (res.ok) {
                    const data = await res.json();
                    data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.value;
                        opt.text = item.text;
                        ddlSubcat.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error("Error al cargar subcategorías:", err);
            }
        }

        async function verDetalleReceta(recetaId) {
            const modal = new bootstrap.Modal(document.getElementById('modalDetalleReceta'));
            document.getElementById('loadingModal').classList.remove('d-none');
            document.getElementById('contenidoModal').classList.add('d-none');
            modal.show();

            try {
                const res = await fetch(`?handler=ObtenerDetalle&recetaId=${recetaId}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        document.getElementById('modalSkuPT').innerText = data.skuPT || 'S/SKU';
                        document.getElementById('modalNombrePT').innerText = data.nombrePT || '-';
                        document.getElementById('lblModalTitulo').innerHTML = `<i class="bi bi-journal-text me-2"></i>Fórmula: ${data.nombreReceta}`;

                        const tbody = document.getElementById('tbodyDetalleInsumos');
                        let html = '';

                        data.detalles.forEach(d => {
                            html += `
                                <tr>
                                    <td class="fw-bold text-primary">${d.skuInsumo || 'S/SKU'}</td>
                                    <td class="fw-semibold text-dark">${d.nombreInsumo || 'Insumo sin nombre'}</td>
                                    <td><small class="text-muted">${d.categoria} / ${d.subCategoria}</small></td>
                                    <td class="text-end fw-bold text-success">${d.cantidad.toFixed(4)}</td>
                                    <td class="text-center"><span class="badge bg-secondary">${d.unidadMedida}</span></td>
                                    <td class="text-end">S/ ${d.costoUnitario.toFixed(2)}</td>
                                    <td class="text-end fw-bold">S/ ${d.subtotal.toFixed(2)}</td>
                                </tr>`;
                        });

                        tbody.innerHTML = html;
                        document.getElementById('loadingModal').classList.add('d-none');
                        document.getElementById('contenidoModal').classList.remove('d-none');
                    }
                }
            } catch (err) {
                console.error("Error al consultar detalle:", err);
            }
        }
    </script>
}