@page "{id:int}"
@model ERP.WEB.Pages.Produccion.Ordenes.DetalleModel
@{
    ViewData["Title"] = $"Detalle OP-{Model.Orden.OrdenProduccionID:D5}";
}

<!-- CABECERA DE LA PÁGINA -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-cpu-fill me-2 text-primary"></i>Orden de Producción: OP-@(Model.Orden.OrdenProduccionID.ToString("D5"))
        </h4>
        <small class="text-muted">Control de ejecución en planta y solicitud de insumos a Almacén</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Produccion/Ordenes/Index" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Regresar a Órdenes
        </a>
        @if (Model.Orden.Estado == "En Proceso" || Model.Orden.Estado == "Finalizada")
        {
            <a asp-page="/Produccion/Ordenes/NotaSalida" asp-route-id="@Model.Orden.OrdenProduccionID" target="_blank" class="btn btn-outline-dark btn-sm fw-semibold">
                <i class="bi bi-file-earmark-pdf me-1"></i> Ver Vale de Salida
            </a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- INFORMACIÓN DE CABECERA Y PANEL DE CONTROL DE ESTADO DE PLANTA -->
<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light py-2">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-info-circle-fill me-2 text-primary"></i>Información General de Fabricación</h6>
            </div>
            <div class="card-body p-3">
                <div class="row g-2">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Cotización Origen</small>
                        <strong class="text-primary fs-6">@(Model.Orden.Cotizacion?.Codigo ?? "N/A")</strong>
                        <small class="d-block text-muted">Cliente: @(Model.Orden.Cotizacion?.ClienteNombre ?? "Producción Interna / Stock")</small>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Producto a Fabricar / Código ID</small>
                        <strong class="text-dark fs-6">Producto ID #@Model.Orden.ProductoID</strong>
                        <small class="d-block text-muted">Cantidad Planificada: <b class="text-dark">@Model.Orden.CantidadPlanificada.ToString("N2") UND/KG</b></small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TARJETA DE ESTADO Y FLUJO DE SOLICITUD A ALMACÉN -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100 @(Model.Orden.Estado == "Pendiente" ? "border-start border-4 border-warning" : Model.Orden.Estado == "Solicitado a Almacén" ? "border-start border-4 border-info" : Model.Orden.Estado == "En Proceso" ? "border-start border-4 border-primary" : "border-start border-4 border-success")">
            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-play-btn-fill me-2 text-primary"></i>Estado & Control de Planta</h6>
                <span class="badge @(Model.Orden.Estado == "Finalizada" ? "bg-success" : Model.Orden.Estado == "En Proceso" ? "bg-primary" : Model.Orden.Estado == "Solicitado a Almacén" ? "bg-info text-dark" : "bg-warning text-dark") fs-7 px-3 py-1 fw-bold">
                    @Model.Orden.Estado
                </span>
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Fecha Emisión:</span>
                    <strong class="text-dark">@Model.Orden.FechaEmision.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>

                <!-- BOTÓN / ALERTA SEGÚN EL ESTADO DE SOLICITUD Y DESPACHO -->
                <div class="mt-2">
                    @if (Model.Orden.Estado == "Pendiente")
                    {
                        <form method="post" asp-page-handler="SolicitarInsumos">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ordenId" value="@Model.Orden.OrdenProduccionID" />
                            <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm" onclick="return confirm('¿Enviar solicitud de insumos a Almacén?');">
                                <i class="bi bi-send-check me-1"></i> Solicitar Insumos a Almacén
                            </button>
                        </form>
                    }
                    else if (Model.Orden.Estado == "Solicitado a Almacén")
                    {
                        <div class="alert alert-info py-2 mb-0 fs-7 text-center fw-semibold">
                            <i class="bi bi-hourglass-split me-1"></i> Solicitud enviada a Almacén. Pendiente de aprobación y despacho física.
                        </div>
                    }
                    else if (Model.Orden.Estado == "En Proceso")
                    {
                        <button type="button" class="btn btn-primary w-100 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalFinalizar">
                            <i class="bi bi-check2-circle me-1"></i> Finalizar Producción & Registrar Ingreso
                        </button>
                    }
                    else if (Model.Orden.Estado == "Finalizada")
                    {
                        <div class="alert alert-success py-1 mb-0 fs-7 text-center fw-semibold">
                            <i class="bi bi-check-all me-1"></i> Producción Finalizada - Ingreso al Kardex
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TABLA DE INSUMOS Y MATERIALES REQUERIDOS (EXPLOSIÓN BOM) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-diagram-3-fill me-2"></i>Insumos & Explosión de Materiales (MRP)</h6>
        <span class="badge bg-light text-dark fs-7"><i class="bi bi-box-seam me-1 text-primary"></i>@(Model.Orden.Consumos?.Count ?? 0) Insumos</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Descripción Insumo / Material</th>
                        <th class="text-center">U.M.</th>
                        <th class="text-end">Cant. Requerida</th>
                        <th class="text-end">Stock Actual Almacén</th>
                        <th class="text-center">Estado Disponibilidad</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orden.Consumos != null && Model.Orden.Consumos.Any())
                    {
                        int index = 1;
                        foreach (var ins in Model.Orden.Consumos)
                        {
                            decimal stockInsumo = 0;
                            if (Model.StocksInsumos != null && Model.StocksInsumos.ContainsKey(ins.InsumoID))
                            {
                                stockInsumo = Model.StocksInsumos[ins.InsumoID];
                            }

                            string nombreInsumo = "Insumo #" + ins.InsumoID;
                            if (Model.NombresInsumos != null && Model.NombresInsumos.ContainsKey(ins.InsumoID))
                            {
                                nombreInsumo = Model.NombresInsumos[ins.InsumoID];
                            }

                            string skuInsumo = "N/A";
                            if (Model.SkuInsumos != null && Model.SkuInsumos.ContainsKey(ins.InsumoID))
                            {
                                skuInsumo = Model.SkuInsumos[ins.InsumoID];
                            }

                            bool tieneStockSuficiente = stockInsumo >= ins.CantidadRequerida;

                            <tr>
                                <td class="text-center fw-bold text-muted">@index</td>
                                <td>
                                    <div class="fw-bold text-dark">@nombreInsumo</div>
                                    <small class="text-primary fw-semibold"><i class="bi bi-barcode me-1"></i>SKU: @skuInsumo</small>
                                </td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@ins.UnidadMedida</span></td>
                                <td class="text-end fw-bold text-primary">@ins.CantidadRequerida.ToString("N2")</td>
                                <td class="text-end fw-bold">@stockInsumo.ToString("N2")</td>
                                <td class="text-center">
                                    @if (Model.Orden.Estado == "En Proceso" || Model.Orden.Estado == "Finalizada")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Despachado por Almacén
                                        </span>
                                    }
                                    else if (tieneStockSuficiente)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i> Stock Disponible en Percha
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Faltan @((ins.CantidadRequerida - stockInsumo).ToString("N2")) @ins.UnidadMedida
                                        </span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay insumos o receta registrados para esta orden de producción.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL PARA FINALIZAR PRODUCCIÓN Y REGISTRAR CANTIDAD REAL EN BALANZA -->
<div class="modal fade" id="modalFinalizar" tabindex="-1" aria-labelledby="modalFinalizarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Finalizar">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ordenId" value="@Model.Orden.OrdenProduccionID" />
                <div class="modal-header bg-dark text-white">
                    <h6 class="modal-header-title mb-0 fw-bold"><i class="bi bi-check2-circle me-2 text-success"></i>Finalizar Producción y Cierre de Lote</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 fs-7">
                        <i class="bi bi-info-circle me-1"></i> Al confirmar, el sistema <b>incrementará el stock</b> del producto fabricado en el inventario.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Cantidad Planificada:</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="@Model.Orden.CantidadPlanificada.ToString("N2")" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Cantidad Real Obtenida (Según Balanza):</label>
                        <input type="number" step="0.01" name="cantidadRealProducida" class="form-control form-control-sm fw-bold text-primary" value="@Model.Orden.CantidadPlanificada" required />
                        <small class="text-muted fs-8">Ajuste este valor si hubo mermas o mayor rendimiento en preparación.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Nro. de Lote / Observaciones:</label>
                        <input type="text" name="observacionesLote" class="form-control form-control-sm" placeholder="Ej: LOTE-CARNE-@(DateTime.Now.ToString("yyyyMMdd"))" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success btn-sm fw-semibold">
                        <i class="bi bi-save me-1"></i> Guardar e Ingresar a Inventario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>