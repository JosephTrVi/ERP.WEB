@page
@model ERP.WEB.Pages.Seguridad.PermisosModel
@{
    ViewData["Title"] = "Gestión de Permisos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-key me-2"></i>Gestión de Permisos</h3>
        <small class="text-muted">Matriz de catálogo de permisos por módulos del sistema</small>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Módulo</th>
                    <th>Subproceso</th>
                    <th>Acción</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListaPermisos)
                {
                    <tr>
                        <td><code class="fw-bold">@item.CodigoPermiso</code></td>
                        <td><span class="badge bg-info text-dark">@item.Modulo</span></td>
                        <td>@item.Subproceso</td>
                        <td>@item.Accion</td>
                        <td>@item.Descripcion</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>