@page
@model ERP.WEB.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Mis Requerimientos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-file-earmark-text me-2 text-primary"></i>
            @(Model.EsAdmin ? "Gestión de Requerimientos (Todos)" : "Mis Requerimientos")
        </h4>
        <small class="text-muted">
            @(Model.EsAdmin ? "Listado general de solicitudes registradas en el sistema" : "Listado de solicitudes de compra y servicio generadas por usted")
        </small>
    </div>
    <a asp-page="/Solicitudes/NuevoRequerimiento" class="btn btn-success fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Requerimiento
    </a>
</div>

<!-- BARRA DE FILTROS POR AÑO, MES Y BÚSQUEDA -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 bg-light">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold small mb-1"><i class="bi bi-calendar-event me-1"></i>Año</label>
                <select asp-for="Anio" asp-items="Model.SelectAnios" class="form-select form-select-sm" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-1"><i class="bi bi-calendar-month me-1"></i>Mes</label>
                <select asp-for="Mes" asp-items="Model.SelectMeses" class="form-select form-select-sm" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-5">
                <label class="form-label fw-semibold small mb-1"><i class="bi bi-search me-1"></i>Buscar por Código / Solicitante</label>
                <input type="text" asp-for="Busqueda" class="form-control form-control-sm" placeholder="Ej: REQ-2026-0001 o Juan Pérez..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- BARRA DE FILTROS -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded-3 p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Tipo de Requerimiento</label>
                <select class="form-select form-select-sm" asp-for="TipoFiltro">
                    <option value="">-- Todos los Tipos --</option>
                    <option value="Nacional">📦 Compras Nacionales</option>
                    <option value="Importacion">🚢 Importaciones</option>
                    <option value="Servicio">🛠️ Servicios</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Estado</label>
                <select class="form-select form-select-sm" asp-for="EstadoFiltro">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Rechazado">Rechazado</option>
                    <option value="Atendido">Atendido</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted mb-1">Buscar por Código / Sustento</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" asp-for="Busqueda" placeholder="Ej: REQ-2026-0001..." />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary btn-sm" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE RESULTADOS -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Prioridad</th>
                        <th>Fecha Solicitud</th>
                        <th>Fecha Requerida</th>
                        <th class="text-center">Ítems</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaRequerimientos.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No se encontraron requerimientos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.ListaRequerimientos)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@req.Codigo</td>
                                <td>
                                    @if (req.TipoRequerimiento == "Nacional")
                                    {
                                        <span class="badge bg-light text-dark border"><i class="bi bi-box-seam me-1"></i>Nacional</span>
                                    }
                                    else if (req.TipoRequerimiento == "Importacion")
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-globe me-1"></i>Importación</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-tools me-1"></i>Servicio</span>
                                    }
                                </td>
                                <td>
                                    @if (req.Prioridad == "Urgente" || req.Prioridad == "Alta")
                                    {
                                        <span class="badge bg-danger">@req.Prioridad</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@req.Prioridad</span>
                                    }
                                </td>
                                <td><small class="text-muted">@req.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td><small class="fw-semibold text-dark">@req.FechaRequerida.ToString("dd/MM/yyyy")</small></td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-light text-dark border fw-bold">@req.Detalles.Count</span>
                                </td>
                                <td class="text-center">
                                    @if (req.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    else if (req.Estado == "Aprobado")
                                    {
                                        <span class="badge bg-success">Aprobado</span>
                                    }
                                    else if (req.Estado == "Rechazado")
                                    {
                                        <span class="badge bg-danger">Rechazado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@req.Estado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>