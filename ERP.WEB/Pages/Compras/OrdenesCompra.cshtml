@page
@model ERP.WEB.Pages.Compras.OrdenesCompraModel
@{
    ViewData["Title"] = "Órdenes de Compra";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Órdenes de Compra Emitidas</h4>
        <small class="text-muted">Control y edición de órdenes de compra del área de Logística</small>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- BARRA DE FILTROS -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded-3 p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-calendar-event me-1"></i>Año</label>
                <select asp-for="Anio" asp-items="Model.SelectAnios" class="form-select form-select-sm" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-calendar-month me-1"></i>Mes</label>
                <select asp-for="Mes" asp-items="Model.SelectMeses" class="form-select form-select-sm" onchange="this.form.submit()"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Estado de la OC</label>
                <select class="form-select form-select-sm" asp-for="EstadoFiltro" onchange="this.form.submit()">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Emitido">Emitido</option>
                    <option value="Pendiente de Atención">Pendiente de Atención</option>
                    <option value="Atendido">Atendido</option>
                    <option value="Anulado">Anulado</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Buscar por Código / Proveedor</label>
                <input type="text" class="form-control form-control-sm" asp-for="Busqueda" placeholder="Ej: OC-2026-0001..." />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-page="/Compras/OrdenesCompra" class="btn btn-outline-secondary btn-sm" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código OC</th>
                        <th>Fecha Emisión</th>
                        <th>Fecha Entrega</th>
                        <th class="text-end">Total OC</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaOrdenesCompra.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2"></i> No existen órdenes de compra registradas para el periodo seleccionado.</td></tr>
                    }
                    else
                    {
                        @foreach (var oc in Model.ListaOrdenesCompra)
                        {
                            string simbolo = oc.Moneda == "USD" ? "$" : "S/";
                            <tr>
                                <td class="fw-bold text-primary">@oc.Codigo</td>
                                <td><small class="text-muted">@oc.FechaEmision.ToString("dd/MM/yyyy")</small></td>
                                <td><small class="fw-semibold text-dark">@(oc.FechaEntrega?.ToString("dd/MM/yyyy") ?? "-")</small></td>
                                <td class="text-end fw-bold text-success">@simbolo @oc.Total.ToString("N2")</td>
                                <td class="text-center">
                                    @if (oc.Estado == "Emitido")
                                    {
                                        <span class="badge bg-info text-dark">Emitido</span>
                                    }
                                    else if (oc.Estado == "Pendiente de Atención")
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente de Atención</span>
                                    }
                                    else if (oc.Estado == "Atendido")
                                    {
                                        <span class="badge bg-success">Atendido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@oc.Estado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <!-- Botón Ver / Editar Datos (Logística) -->
                                    <button class="btn btn-sm btn-outline-primary fw-semibold" onclick='verEditarOC(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(oc, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles })))'>
                                        <i class="bi bi-pencil-square me-1"></i> Ver / Editar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL CONSULTA Y EDICIÓN DE OC (LOGÍSTICA) -->
<div class="modal fade" id="modalEditarOC" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="modalTituloOC"><i class="bi bi-file-earmark-text me-2"></i> Orden de Compra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="ActualizarDatosOC">
                <input type="hidden" name="ordenCompraId" id="txtModalOCID" />
                <div class="modal-body">
                    <div class="row g-3 mb-3 bg-light p-3 rounded border">
                        <div class="col-md-4"><small class="text-muted d-block">Estado Actual:</small> <strong id="lblModalEstado"></strong></div>
                        <div class="col-md-4"><small class="text-muted d-block">Moneda:</small> <strong id="lblModalMoneda"></strong></div>
                        <div class="col-md-4"><small class="text-muted d-block">Fecha Emisión:</small> <span id="lblModalFecha"></span></div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-list-check me-1 text-primary"></i> Detalle de Precios y Cantidades Solicitadas</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Artículo / Servicio</th>
                                    <th>U.M.</th>
                                    <th style="width: 120px;" class="text-end">Cantidad</th>
                                    <th style="width: 150px;" class="text-end">Precio Unitario</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyModalDetalles"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary fw-semibold" id="btnGuardarCambiosOC">
                        <i class="bi bi-save me-1"></i> Guardar Modificaciones
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verEditarOC(oc) {
            const ocId = oc.OrdenCompraID || oc.ordenCompraID;
            const esEditable = oc.Estado !== "Atendido" && oc.Estado !== "Anulado";

            document.getElementById('txtModalOCID').value = ocId;
            document.getElementById('modalTituloOC').innerText = `Orden de Compra ${oc.Codigo || oc.codigo}`;
            document.getElementById('lblModalEstado').innerText = oc.Estado || oc.estado;
            document.getElementById('lblModalMoneda').innerText = oc.Moneda || oc.moneda;

            const fecha = oc.FechaEmision || oc.fechaEmision;
            document.getElementById('lblModalFecha').innerText = fecha ? fecha.substring(0, 10) : '';

            const btnGuardar = document.getElementById('btnGuardarCambiosOC');
            if (esEditable) {
                btnGuardar.classList.remove('d-none');
            } else {
                btnGuardar.classList.add('d-none');
            }

            const tbody = document.getElementById('tbodyModalDetalles');
            tbody.innerHTML = '';

            const detalles = oc.Detalles || oc.detalles || [];
            detalles.forEach(d => {
                const detId = d.OrdenCompraDetalleID || d.ordenCompraDetalleID;
                const desc = d.DescripcionItem || d.descripcionItem || 'Artículo';
                const um = d.UnidadMedida || d.unidadMedida || 'UND';
                const cant = d.Cantidad !== undefined ? d.Cantidad : d.cantidad;
                const precio = d.PrecioUnitario !== undefined ? d.PrecioUnitario : d.precioUnitario;

                const inputCant = esEditable
                    ? `<input type="number" step="0.01" class="form-control form-control-sm text-end" name="cantidades[${detId}]" value="${cant}" />`
                    : `<span class="fw-bold">${cant}</span>`;

                const inputPrecio = esEditable
                    ? `<input type="number" step="0.0001" class="form-control form-control-sm text-end" name="precios[${detId}]" value="${precio}" />`
                    : `<span class="fw-bold">${precio}</span>`;

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${desc}</strong></td>
                        <td><span class="badge bg-secondary">${um}</span></td>
                        <td class="text-end">${inputCant}</td>
                        <td class="text-end">${inputPrecio}</td>
                    </tr>`;
            });

            const modal = new bootstrap.Modal(document.getElementById('modalEditarOC'));
            modal.show();
        }
    </script>
}