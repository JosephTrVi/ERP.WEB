@page
@model ERP.WEB.Pages.Compras.BandejaRequerimientosModel
@{
    ViewData["Title"] = "Requerimientos Aprobados - Compras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-cart-check me-2 text-info"></i>Requerimientos Aprobados
        </h4>
        <small class="text-muted">Bandeja de gestión logística para cotizar y emitir Órdenes de Compra (OC)</small>
    </div>
    <span class="badge bg-success fs-6">Por Atender: @Model.RequerimientosAprobados.Count</span>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- BARRA DE FILTROS -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded-3 p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted mb-1">Tipo de Requerimiento</label>
                <select class="form-select form-select-sm" asp-for="TipoFiltro">
                    <option value="">-- Todos los Tipos --</option>
                    <option value="Nacional">📦 Compras Nacionales</option>
                    <option value="Importacion">🚢 Importaciones</option>
                    <option value="Servicio">🛠️️ Servicios</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-muted mb-1">Buscar por Código / Sustento</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" asp-for="Busqueda" placeholder="Ej: REQ-2026-0001..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-page="/Compras/BandejaRequerimientos" class="btn btn-outline-secondary btn-sm" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE REQUERIMIENTOS APROBADOS -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código RQ</th>
                        <th>Tipo Solicitud</th>
                        <th>Prioridad</th>
                        <th>Fecha Aprobación</th>
                        <th>Fecha Requerida</th>
                        <th class="text-center">Ítems</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RequerimientosAprobados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No hay requerimientos aprobados pendientes de emisión de OC.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.RequerimientosAprobados)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@req.Codigo</td>
                                <td>
                                    @if (req.TipoRequerimiento == "Nacional")
                                    {
                                        <span class="badge bg-light text-dark border">📦 Nacional</span>
                                    }
                                    else if (req.TipoRequerimiento == "Importacion")
                                    {
                                        <span class="badge bg-info text-dark">🚢 Importación</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">🛠️ Servicio</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(req.Prioridad == "Urgente" || req.Prioridad == "Alta" ? "bg-danger" : "bg-secondary")">@req.Prioridad</span>
                                </td>
                                <td><small class="text-dark fw-semibold">@(req.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small></td>
                                <td><small class="fw-semibold text-muted">@req.FechaRequerida.ToString("dd/MM/yyyy")</small></td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-primary fw-bold">@req.Detalles.Count</span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Ver Detalle" onclick='verDetalleCompleto(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(req, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles })))'>
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a asp-page="/Compras/GenerarOC" asp-route-requerimientoId="@req.RequerimientoID" class="btn btn-sm btn-success fw-semibold">
                                        <i class="bi bi-cart-plus me-1"></i> Generar OC
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL VER DETALLE DE REQUERIMIENTO -->
<div class="modal fade" id="modalDetalleReq" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="modalTituloReq"><i class="bi bi-info-circle me-2"></i> Detalle del Requerimiento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3 bg-light p-3 rounded border">
                    <div class="col-md-4"><small class="text-muted d-block">Tipo Solicitud:</small> <strong id="lblTipo"></strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Prioridad:</small> <strong id="lblPrioridad"></strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Fecha Requerida:</small> <strong id="lblFechaReq"></strong></div>
                    <div class="col-12 mt-2"><small class="text-muted d-block">Sustento / Observaciones:</small> <span id="lblSustento" class="fst-italic text-dark"></span></div>
                    <div class="col-12 mt-1"><small class="text-muted d-block">Comentario de Aprobación Jefatura:</small> <span id="lblComentarioJefe" class="fw-semibold text-success"></span></div>
                </div>

                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-list-check me-1 text-primary"></i> Ítems Aprobados para Compras</h6>
                <div class="table-responsive mb-0">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Artículo / Servicio</th>
                                <th class="text-end" style="width: 120px;">Cantidad</th>
                                <th style="width: 80px;">U.M.</th>
                                <th>Especificaciones Técnicas</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDetallesModal"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <a id="btnIrAGenerarOC" href="#" class="btn btn-success fw-semibold">
                    <i class="bi bi-cart-plus me-1"></i> Ir a Generar Orden de Compra
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalleCompleto(req) {
            const reqId = req.RequerimientoID || req.requerimientoID || 0;
            const detalles = req.Detalles || req.detalles || [];

            document.getElementById('modalTituloReq').innerText = `Requerimiento ${req.Codigo || req.codigo || ''}`;
            document.getElementById('lblTipo').innerText = req.TipoRequerimiento || req.tipoRequerimiento || '';
            document.getElementById('lblPrioridad').innerText = req.Prioridad || req.prioridad || '';

            const fechaReq = req.FechaRequerida || req.fechaRequerida;
            document.getElementById('lblFechaReq').innerText = fechaReq ? fechaReq.substring(0, 10) : '';
            document.getElementById('lblSustento').innerText = (req.Observaciones || req.observaciones) || 'Sin observaciones.';
            document.getElementById('lblComentarioJefe').innerText = (req.ComentarioAprobacion || req.comentarioAprobacion) || 'Aprobado sin comentarios.';

            document.getElementById('btnIrAGenerarOC').href = `/Compras/GenerarOC/${reqId}`;

            const tbody = document.getElementById('tbodyDetallesModal');
            tbody.innerHTML = '';

            if (detalles.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-3">No se encontraron ítems en esta solicitud.</td></tr>`;
            } else {
                detalles.forEach((d) => {
                    const prod = d.Producto || d.producto;
                    const sku = prod ? (prod.SKU || prod.sku || '') : '';
                    const nombreProd = prod ? (prod.Nombre || prod.nombre || '') : '';

                    let descripcion = d.DescripcionItem || d.descripcionItem || nombreProd;
                    if (!descripcion || descripcion.trim() === "" || descripcion === "null" || descripcion === "Artículo / Servicio") {
                        descripcion = nombreProd || "Artículo sin descripción";
                    }

                    const um = d.UnidadMedida || d.unidadMedida || 'UND';
                    const cantidad = d.Cantidad !== undefined ? d.Cantidad : (d.cantidad !== undefined ? d.cantidad : 0);
                    const especificaciones = d.EspecificacionesTecnicas || d.especificacionesTecnicas || '-';

                    const displayNombre = sku
                        ? `<code class="me-1 text-primary fw-bold">[${sku}]</code> <strong>${descripcion}</strong>`
                        : `<strong>${descripcion}</strong>`;

                    tbody.innerHTML += `
                        <tr>
                            <td class="text-dark">${displayNombre}</td>
                            <td class="text-end fw-bold text-primary">${cantidad}</td>
                            <td><span class="badge bg-secondary">${um}</span></td>
                            <td><small class="text-muted">${especificaciones}</small></td>
                        </tr>`;
                });
            }

            const modal = new bootstrap.Modal(document.getElementById('modalDetalleReq'));
            modal.show();
        }
    </script>
}