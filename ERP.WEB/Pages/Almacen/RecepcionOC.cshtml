@page "{ordenCompraId:int}"
@model ERP.WEB.Pages.Almacen.RecepcionOCModel
@{
    ViewData["Title"] = "Recepción de Orden de Compra";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-box-arrow-in-down me-2 text-success"></i>Recepción de Mercadería en Planta</h4>
        <small class="text-muted">Registro de Ingreso a Almacén para la Orden de Compra <strong>@Model.OrdenCompra?.Codigo</strong></small>
    </div>
    <a asp-page="/Compras/OrdenesCompra" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Regresar a Órdenes
    </a>
</div>

<form method="post" asp-page-handler="GuardarIngreso" id="formIngreso">
    <input type="hidden" asp-for="InputIngreso.OrdenCompraID" />
    <input type="hidden" asp-for="ItemsIngresoJson" id="txtItemsIngresoJson" />

    <!-- DATOS DE LA NOTA DE INGRESO Y COMPROBANTES -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-dark text-white py-2">
            <h6 class="mb-0 fw-bold"><i class="bi bi-journal-check me-2"></i>Datos de Recepción, Guía y Factura</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">N° Nota Ingreso</label>
                    <input type="text" class="form-control bg-light fw-bold text-primary" asp-for="InputIngreso.Codigo" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Almacén / Local Destino <span class="text-danger">*</span></label>
                    <select class="form-select fw-bold" asp-for="InputIngreso.AlmacenID" asp-items="Model.SelectAlmacenes" required>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Serie Guía Remisión <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" asp-for="InputIngreso.SerieGuiaRemision" placeholder="Ej: T001" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Número Guía Remisión <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" asp-for="InputIngreso.NumeroGuiaRemision" placeholder="Ej: 00004589" required />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Serie Factura Proveedor</label>
                    <input type="text" class="form-control" asp-for="InputIngreso.SerieFactura" placeholder="Ej: F001 (Opcional)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Número Factura Proveedor</label>
                    <input type="text" class="form-control" asp-for="InputIngreso.NumeroFactura" placeholder="Ej: 00012399 (Opcional)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Observaciones del Almacenero</label>
                    <input type="text" class="form-control" asp-for="InputIngreso.ObservacionesAlmacen" placeholder="Empaque en buen estado, precintos verificados..." />
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE ARTÍCULOS A INGRESAR -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-check me-2 text-primary"></i>Cantidades Recibidas Físicamente</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Artículo / Servicio</th>
                            <th>U.M.</th>
                            <th class="text-end" style="width: 120px;">Cant. Solicitada</th>
                            <th class="text-end" style="width: 120px;">Recibido Previo</th>
                            <th class="text-end" style="width: 120px;">Saldo Pendiente</th>
                            <th class="text-end" style="width: 170px;">Cant. A Ingresar Ahora <span class="text-danger">*</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrdenCompra.Detalles)
                        {
                            decimal atendidoPrevio = Model.CantidadesAtendidasPrevias.ContainsKey(item.OrdenCompraDetalleID) ? Model.CantidadesAtendidasPrevias[item.OrdenCompraDetalleID] : 0;
                            decimal saldoPendiente = item.Cantidad - atendidoPrevio;
                            if (saldoPendiente < 0) saldoPendiente = 0;

                            string desc = !string.IsNullOrWhiteSpace(item.DescripcionItem) ? item.DescripcionItem : (item.Producto?.Nombre ?? "Artículo");

                            <tr>
                                <td>
                                    <input type="hidden" class="item-oc-det-id" value="@item.OrdenCompraDetalleID" />
                                    <input type="hidden" class="item-prod-id" value="@(item.ProductoID ?? 0)" />
                                    <strong class="text-dark">@desc</strong>
                                    @if (item.Producto != null && !string.IsNullOrEmpty(item.Producto.SKU))
                                    {
                                        <br />
                                
                                        <small class="text-primary fw-bold">SKU: @item.Producto.SKU</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@item.UnidadMedida</span></td>
                                <td class="text-end fw-bold text-dark">@item.Cantidad.ToString("N2")</td>
                                <td class="text-end text-muted fw-bold">@atendidoPrevio.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">@saldoPendiente.ToString("N2")</td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="@saldoPendiente" class="form-control form-control-sm text-end fw-bold text-success item-cant-ingresar" value="@saldoPendiente" oninput="prepararJsonIngreso()" onchange="prepararJsonIngreso()" required />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="/Compras/OrdenesCompra" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-success fw-semibold px-4"><i class="bi bi-check-circle me-1"></i> Registrar Ingreso a Planta</button>
    </div>
</form>

@section Scripts {
    <script>
        function prepararJsonIngreso() {
            const filas = document.querySelectorAll('tbody tr');
            const listaItems = [];

            filas.forEach(f => {
                const ocDetId = parseInt(f.querySelector('.item-oc-det-id').value) || 0;
                const prodId = parseInt(f.querySelector('.item-prod-id').value) || 0;
                const cant = parseFloat(f.querySelector('.item-cant-ingresar').value) || 0;

                listaItems.push({
                    OrdenCompraDetalleID: ocDetId,
                    ProductoID: prodId,
                    CantidadIngresar: cant
                });
            });

            document.getElementById('txtItemsIngresoJson').value = JSON.stringify(listaItems);
        }

        document.addEventListener("DOMContentLoaded", function() {
            prepararJsonIngreso();
        });
    </script>
}