@page
@model ERP.WEB.Pages.Almacen.BandejaRecepcionModel
@{
    ViewData["Title"] = "Recepción de Mercadería";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-box-arrow-in-down me-2 text-success"></i>Bandeja de Recepción en Planta</h4>
        <small class="text-muted">Gestión exclusiva de Almacén para recepción de Órdenes de Compra</small>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código OC</th>
                        <th>Fecha Emisión</th>
                        <th>Fecha Entrega Estimada</th>
                        <th class="text-center">Estado OC</th>
                        <th class="text-center">Ítems Solicitados</th>
                        <th class="text-end">Acción Almacén</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.OrdenesPendientes.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle-fill fs-2 d-block text-success mb-2"></i>
                                No hay órdenes de compra pendientes de atención en planta.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var oc in Model.OrdenesPendientes)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@oc.Codigo</td>
                                <td><small class="text-muted">@oc.FechaEmision.ToString("dd/MM/yyyy")</small></td>
                                <td><small class="fw-semibold text-dark">@(oc.FechaEntrega?.ToString("dd/MM/yyyy") ?? "-")</small></td>
                                <td class="text-center">
                                    @if (oc.Estado == "Emitido")
                                    {
                                        <span class="badge bg-info text-dark">Pendiente Recepción</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Entrega Parcial</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-primary fw-bold">@oc.Detalles.Count</span>
                                </td>
                                <td class="text-end">
                                    <a asp-page="/Almacen/RecepcionOC" asp-route-ordenCompraId="@oc.OrdenCompraID" class="btn btn-sm btn-success fw-semibold">
                                        <i class="bi bi-box-arrow-in-down me-1"></i> Recepcionar Mercadería
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>