<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP PLANTA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- BARRA LATERAL FIJA (SIDEBAR) -->
    <aside class="sidebar shadow-sm" id="sidebar">
        <div class="brand-header">
            <a class="text-white text-decoration-none fw-bold fs-5 d-flex align-items-center" asp-page="/Index">
                <i class="bi bi-gear-wide-connected text-primary me-2 fs-4"></i>
                <span>ERP PLANTA</span>
            </a>
        </div>

        <div class="py-2">
            <!-- GENERAL -->
            <div class="sidebar-heading">Principal</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
            </ul>

            <!-- MÓDULO INDEPENDIENTE / TRANSVERSAL -->
            <div class="sidebar-heading">Solicitudes</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Solicitudes/NuevoRequerimiento">
                        <i class="bi bi-file-earmark-plus me-2"></i> Mis Requerimientos
                    </a>
                </li>
            </ul>

            <!-- MÓDULOS DE ÁREAS (DESPLEGABLES TIPO ACORDEÓN) -->
            <div class="sidebar-heading">Áreas de Trabajo</div>
            <!-- Se agregó id="accordionSidebar" a la lista -->
            <ul class="nav flex-column" id="accordionSidebar">

                <!-- 1. SEGURIDAD -->
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuSeguridad" role="button" aria-expanded="false">
                        <i class="bi bi-shield-lock me-2 text-warning"></i>
                        <span>Seguridad</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <!-- Se agregó data-bs-parent="#accordionSidebar" -->
                    <div class="collapse" id="menuSeguridad" data-bs-parent="#accordionSidebar">
                        <ul class="nav flex-column submenu">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Seguridad/Usuarios">
                                    <i class="bi bi-people me-2"></i> Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Seguridad/Permisos">
                                    <i class="bi bi-key me-2"></i> Permisos y Roles
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- 2. RECURSOS HUMANOS -->
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuRRHH" role="button" aria-expanded="false">
                        <i class="bi bi-people-fill me-2 text-info"></i>
                        <span>Recursos Humanos</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <!-- Se agregó data-bs-parent="#accordionSidebar" -->
                    <div class="collapse" id="menuRRHH" data-bs-parent="#accordionSidebar">
                        <ul class="nav flex-column submenu">
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#">
                                    <i class="bi bi-person-badge me-2"></i> Gestión Empleados
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#">
                                    <i class="bi bi-building me-2"></i> Áreas de Trabajo
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- 3. ALMACÉN E INVENTARIO -->
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuAlmacen" role="button" aria-expanded="false">
                        <i class="bi bi-box-seam me-2 text-success"></i>
                        <span>Almacén e Inventario</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <div class="collapse" id="menuAlmacen" data-bs-parent="#accordionSidebar">
                        <ul class="nav flex-column submenu">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Almacen/Categorias">
                                    <i class="bi bi-folder-symlink me-2"></i> Categorías / SubCat.
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Almacen/Articulos">
                                    <i class="bi bi-tags me-2"></i> Catálogo Artículos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#">
                                    <i class="bi bi-journal-bookmark me-2"></i> Movimientos Kárdex
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- 4. LOGÍSTICA Y COMPRAS -->
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuLogistica" role="button" aria-expanded="false">
                        <i class="bi bi-cart-check me-2 text-primary"></i>
                        <span>Logística y Compras</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <!-- Se agregó data-bs-parent="#accordionSidebar" -->
                    <div class="collapse" id="menuLogistica" data-bs-parent="#accordionSidebar">
                        <ul class="nav flex-column submenu">
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#">
                                    <i class="bi bi-clipboard-check me-2"></i> Requerimientos Aprobados
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#">
                                    <i class="bi bi-file-earmark-spreadsheet me-2"></i> Órdenes de Compra
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- 5. PRODUCCIÓN -->
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuProduccion" role="button" aria-expanded="false">
                        <i class="bi bi-tools me-2 text-danger"></i>
                        <span>Producción</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </a>
                    <!-- Se agregó data-bs-parent="#accordionSidebar" -->
                    <div class="collapse" id="menuProduccion" data-bs-parent="#accordionSidebar">
                        <ul class="nav flex-column submenu">
                            <li class="nav-item">
                                <a class="nav-link disabled" href="#">
                                    <i class="bi bi-gear-fill me-2"></i> Órdenes de Producción
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

            </ul>
        </div>
    </aside>

    <!-- BARRA SUPERIOR (TOPBAR) -->
    <header class="topbar justify-content-between">
        <div class="d-flex align-items-center">
            <button class="btn btn-light d-lg-none me-2" type="button" onclick="toggleSidebar()">
                <i class="bi bi-list fs-4"></i>
            </button>
            <h6 class="mb-0 text-muted fw-semibold">@ViewData["Title"]</h6>
        </div>

        <!-- PERFIL DE USUARIO Y LOGOUT -->
        <div class="d-flex align-items-center">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border-0 d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle text-primary fs-5 me-2"></i>
                        <span class="fw-semibold me-1">@(User.FindFirst("NombreEmpleado")?.Value ?? User.Identity.Name)</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userMenu">
                        <li>
                            <span class="dropdown-item-text text-muted small">
                                Rol: <strong>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario")</strong>
                            </span>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
        }

        // Script para desplegar el menú activo
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.sidebar .submenu .nav-link, .sidebar > .py-2 > .nav > .nav-item > .nav-link');

            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href && href !== '#' && currentPath.includes(href.toLowerCase())) {
                    link.classList.add('active');

                    // Desplegar el menú padre correspondiente
                    const parentCollapse = link.closest('.collapse');
                    if (parentCollapse) {
                        parentCollapse.classList.add('show');
                        const toggleTrigger = document.querySelector(`[href="#${parentCollapse.id}"]`);
                        if (toggleTrigger) {
                            toggleTrigger.setAttribute('aria-expanded', 'true');
                            toggleTrigger.classList.add('active');
                        }
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>